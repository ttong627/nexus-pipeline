{
  "name": "nexus-pipeline",
  "private": true,
  "version": "7.25.0",
  "type": "module",
  "scripts": {
    "test:rules": "firebase emulators:exec --only firestore --project demo-nexus-rules \"node scripts/rules/firestore-rules.test.mjs\"",
    "dev": "vite",
    "version:bump": "node scripts/bump-version.cjs",
    "release": "node scripts/bump-version.cjs",
    "prebuild": "eslint . --max-warnings 120 && tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "deploy": "firebase deploy --only hosting --account ttong627@gmail.com",
    "deploy:hosting": "firebase deploy --only hosting --account ttong627@gmail.com",
    "deploy:rules": "firebase deploy --only firestore:rules --account ttong627@gmail.com",
    "deploy:functions": "firebase deploy --only functions:openShare,functions:api,functions:geocode,functions:geocodeAuto,functions:leakAlert --account ttong627@gmail.com",
    "lint": "eslint .",
    "test:e2e": "playwright test --workers=1",
    "preview": "vite preview",
    "test:all": "node --test scripts/*.test.mjs && eslint . --max-warnings 120 && tsc --noEmit && vite build && playwright test --workers=1"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.13.24",
    "firebase": "^12.12.1",
    "html2canvas": "^1.4.1",
    "jquery": "^3.7.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.14.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "xlsx-js-style": "^1.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.2.4",
    "@tailwindcss/vite": "^4.2.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "firebase-admin": "^13.10.0",
    "globals": "^17.5.0",
    "postcss": "^8.5.14",
    "tailwindcss": "^4.2.4",
    "typescript": "^6.0.3",
    "vite": "^8.0.10",
    "vite-plugin-pwa": "^1.3.0"
  }
}
