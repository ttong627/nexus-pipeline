# ── NEXUS PIPELINE 환경변수 템플릿 ───────────────────────────────
# 사용법: 이 파일을 복사해 ".env" 로 저장 후 실제 값 입력 (.env 는 git 제외됨)
#   cp .env.example .env
#
# 값 찾는 곳:
#  - VITE_FIREBASE_* : Firebase 콘솔 → 프로젝트(logis-op) 설정 → 일반 → "내 앱" SDK 설정 및 구성
#  - VITE_KAKAO_REST_KEY : Kakao Developers → 내 애플리케이션 → 앱 키 → REST API 키
#  - VITE_ADDRESS_MATCH_API_URL : 주소매칭 백엔드(예: Cloud Run) 기본 URL (끝 슬래시 없이)

# Firebase 웹 SDK (공개 클라이언트 설정 — 비밀 아님)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=logis-op.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=logis-op
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# 주소 정제 API
VITE_KAKAO_REST_KEY=
VITE_ADDRESS_MATCH_API_URL=

# ── import 스크립트 전용 (base_lists 쓰기 = firebase-admin 서비스계정) ──
# Firebase 콘솔 → 프로젝트 설정 → 서비스 계정 → "새 비공개 키 생성" → 받은 JSON 을
# 프로젝트 루트에 serviceAccountKey.json 으로 저장 (git 제외됨).
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json
