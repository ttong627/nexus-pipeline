PORT=8080
DATABASE_URL=postgresql://ADDRESS_APP:CHANGE_ME@/nexus?host=/cloudsql/PROJECT:REGION:INSTANCE
PGSSL=disable
PGPOOL_MAX=8
ADDRESS_DB_SCHEMA=nexus_address
ADDRESS_DB_VERSION=202604
ADDRESS_REFERENCE_DATE=2026-04-30
ADDRESS_SOURCE_BUCKET=nexus-address-source
ADDRESS_SOURCE_PREFIX=address-source/202604
ADDRESS_SOURCE_ENCODING=cp949
ADDRESS_IMPORT_BATCH_SIZE=1000
ADDRESS_ALLOWED_ORIGINS=https://YOUR_FIREBASE_HOSTING_DOMAIN
JUSO_API_KEYS=JUSO_KEY_1,JUSO_KEY_2,JUSO_KEY_3
KAKAO_REST_KEY=KAKAO_REST_API_KEY
# VWorld(국토부 공간정보) 인증키 — 지오코더 우선 폴백 + LT_C_SPBD 건물(동별) 좌표
VWORLD_KEY=VWORLD_API_KEY
# ── P7 Phase2: 주소 규격화(/v1/address/purify) ──────────────────────
# 학습사전(Firestore) 로더는 ADC를 쓴다 — 키파일 없음. Cloud Run 런타임 SA에
# roles/datastore.viewer 필요. 미부여여도 서버는 죽지 않고 빈 사전으로 계속 동작한다.
FIREBASE_PROJECT_ID=logis-op
ADDRESS_DICT_TTL_MS=300000
# ⚠️ purify는 운영 /v1/address/match와 Cloud SQL 1대(1 vCPU)를 공유한다. 2026-08-01 실측으로
#    '없는 주소'가 많은 명단은 퍼지·건물명 트리그램 경로로 빠져 DB CPU를 점유하고 운영 매칭을
#    500(10초 커넥션 타임아웃)으로 끌어내렸다. 이 값을 올리지 말 것 — 대량 백필은 점검 시간대나 DB 증설로.
ADDRESS_PURIFY_CONCURRENCY=1
ADDRESS_PURIFY_MAX_RECORDS=50
