rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function userData() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return request.auth != null && userData().role == 'admin';
    }

    // 승인된 지자체 사용자 여부 확인 (#1)
    function hasCityAccess(cityId) {
      return request.auth != null &&
        'citiesApproved' in userData() &&
        userData().citiesApproved is list &&
        userData().citiesApproved.hasAll([cityId]);
    }

    // cloud_uploads: 관리자만 쓰기, 승인된 해당 cityId 사용자만 읽기 (#1)
    match /cloud_uploads/{cityId}/{allPaths=**} {
      allow read: if isAdmin() || hasCityAccess(cityId);
      allow write: if isAdmin();
    }

    // ── 배송 루트 KML: **사용하지 않는다**(코드 참조 0건 · 2026-08-23 점검).
    //   예전 규칙은 `allow read: if true` 로 전면 공개 + 인증자 아무나 업로드였다 —
    //   회사 도메인에 임의 파일을 올려 두는 통로가 되고, 과거 KML 에는 주소·좌표가 들어 있다.
    //   되살릴 일이 생기면 공유 토큰 검증을 붙인 뒤에 열 것.
    match /route_kml/{fileName} {
      allow read, write: if false;
    }

    // 기타 모든 경로 접근 거부
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
