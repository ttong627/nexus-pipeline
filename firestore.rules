rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ★공유 비밀번호 토큰(claims.shareId · openShare 발급)은 "인증 사용자"가 아니다(2026-08-23 검사 지적).
    //   이걸 빼지 않으면 기사 토큰으로 users/{uid} 를 스스로 만들어 관리자로 올라가는 체인이 열린다.
    //   (SSO 담당자도 커스텀 토큰을 쓰므로 provider 가 아니라 shareId 클레임으로 가른다)
    function isAuthenticated() {
      return request.auth != null && !('shareId' in request.auth.token);
    }

    function isAdmin() {
      // users 문서가 없는 담당자(SSO 첫 진입·테스트)는 평가 오류가 아니라 **명시적 false** — exists 를 먼저 본다
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'admin';
    }

    // DB 읽기 없이 Auth 토큰에서 직접 확인 — 관리자 자기복구용 (#4)
    function isAdminEmail() {
      return isAuthenticated() &&
        request.auth.token.get('email', '') in [
          'ttong627@gmail.com'
        ];
    }

    // ── 오타 사전: 공동 기여 (모든 인증 사용자) ──────────────────────────────
    match /typo_dict/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || isAdminEmail();
    }

    match /typo_suggestions/{docId} {
      allow create: if isAuthenticated() &&
        request.resource.data.keys().hasOnly(['wrong', 'correction', 'status', 'createdAt', 'createdBy', 'createdByUid', 'source']) &&
        request.resource.data.status == 'pending';
      allow read, update, delete: if isAdmin() || isAdminEmail();
    }

    // ── 특수문자 사전: 공동 기여 (모든 인증 사용자) (#6) ─────────────────────
    match /special_chars/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || isAdminEmail();
    }

    match /special_char_suggestions/{docId} {
      allow create: if isAuthenticated() &&
        request.resource.data.keys().hasOnly(['char', 'status', 'createdAt', 'createdBy', 'createdByUid', 'source']) &&
        request.resource.data.status == 'pending';
      allow read, update, delete: if isAdmin() || isAdminEmail();
    }

    // ── 자가학습 후보 큐: 인증 사용자 기여, 검토·집계·승격은 관리자 (Phase 1~3) ──
    match /learn_candidates/{docId} {
      allow create: if isAuthenticated() &&
        request.resource.data.keys().hasOnly([
          'field', 'before', 'after', 'type', 'risk', 'ruleKey',
          'payload', 'reason', 'status', 'city', 'month', 'uid', 'createdAt'
        ]);
      allow read, list, update, delete: if isAdmin() || isAdminEmail();
    }

    // ── 자가학습 승격 사전 (저위험 자동 반영) — dict=관리자 쓰기, suggestion=인증 사용자 기여 ──
    match /name_typo_dict/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || isAdminEmail();
    }
    match /name_typo_suggestions/{docId} {
      allow create: if isAuthenticated() &&
        request.resource.data.keys().hasOnly(['wrong', 'correction', 'status', 'createdAt', 'createdByUid']) &&
        request.resource.data.status == 'pending';
      allow read, update, delete: if isAdmin() || isAdminEmail();
    }
    match /building_alias/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || isAdminEmail();
    }
    match /building_alias_suggestions/{docId} {
      allow create: if isAuthenticated() &&
        request.resource.data.keys().hasOnly(['alias', 'canonical', 'status', 'createdAt', 'createdByUid']) &&
        request.resource.data.status == 'pending';
      allow read, update, delete: if isAdmin() || isAdminEmail();
    }
    match /note_hints/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || isAdminEmail();
    }
    match /note_hints_suggestions/{docId} {
      allow create: if isAuthenticated() &&
        request.resource.data.keys().hasOnly(['hint', 'status', 'createdAt', 'createdByUid']) &&
        request.resource.data.status == 'pending';
      allow read, update, delete: if isAdmin() || isAdminEmail();
    }
    match /note_normalize_dict/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || isAdminEmail();
    }
    match /note_normalize_suggestions/{docId} {
      allow create: if isAuthenticated() &&
        request.resource.data.keys().hasOnly(['wrong', 'correction', 'status', 'createdAt', 'createdByUid']) &&
        request.resource.data.status == 'pending';
      allow read, update, delete: if isAdmin() || isAdminEmail();
    }

    // ── 문의: 생성은 인증 사용자, 조회·수정·삭제는 관리자 ────────────────────
    match /inquiries/{inquiryId} {
      allow create: if isAuthenticated();
      allow read, update, delete: if isAdmin();
    }

    // ── AI 로그: 생성은 인증 사용자 (허용 필드 제한), 나머지는 관리자 ──────────
    match /nexus_ai_logs/{document=**} {
      allow create: if isAuthenticated() &&
        request.resource.data.keys().hasOnly([
          'columnName', 'status', 'detectedAt', 'fileName', 'sheetName', 'expireAt',
          'type', 'mappedTo', 'loggedAt', 'userEmail', 'city'
        ]);
      allow read, update, delete: if isAdmin();
    }

    // ── 시스템 설정: 읽기는 인증 사용자, 쓰기는 관리자 ──────────────────────
    match /nexus_config/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ── 감사 로그: 생성은 모든 인증 사용자 (허용 필드 제한), 조회·수정·삭제는 관리자만 (#7) ───
    match /audit_logs/{document=**} {
      allow create: if isAuthenticated() &&
        request.resource.data.keys().hasOnly([
          'action', 'targetName', 'targetUid', 'targetEmail', 'updates', 'city', 'monthId',
          'count', 'validCount', 'errorCount', 'workflowMeta',
          'addCount', 'updateCount', 'successCount',
          'timestamp', 'adminEmail', 'expireAt', 'uid'
        ]);
      allow read, update, delete: if isAdmin();
    }

    // ── 에러 로그: 생성은 인증 사용자(허용 필드 제한), 조회·수정·삭제는 관리자만 ──────
    match /error_logs/{document=**} {
      allow create: if isAuthenticated() &&
        request.resource.data.keys().hasOnly([
          'message', 'stack', 'source', 'url', 'userAgent', 'appVersion',
          'userEmail', 'uid', 'extra', 'timestamp', 'expireAt'
        ]);
      allow read, update, delete: if isAdmin();
    }

    // ── 이용 기록: 쓰기는 서버(Cloud Functions·admin SDK)만, 조회는 관리자만 ──────
    //  ★클라이언트 create 금지 — IP·uid를 위조한 가짜 이용기록을 막는다.
    //    서버는 admin SDK라 이 규칙을 우회한다(정상). 개인정보라 180일 TTL 자동 삭제.
    match /usage_events/{document=**} {
      allow read: if isAdmin() || isAdminEmail();
      allow create, update, delete: if false;
    }

    // ── 사용자: 본인 읽기/생성/수정 + 관리자 전체 제어 ──────────────────────
    match /users/{userId} {
      allow read: if isAuthenticated() &&
        (request.auth.uid == userId || isAdmin());

      // 최초 생성도 일반 등급만 — role/tier 를 들고 태어나는 문서는 막는다(2026-08-23 검사 지적: 자가 승격 차단)
      allow create: if isAuthenticated() && request.auth.uid == userId
                    && request.resource.data.get('role', 'user') == 'user'
                    && request.resource.data.get('tier', 'basic') == 'basic'
                    && !request.resource.data.keys().hasAny(['maxCities', 'citiesApproved', 'orgAssignments', 'orgId']);

      // 일반 사용자: role·tier·maxCities·status·citiesApproved·orgAssignments 직접 변경 불가
      allow update: if isAuthenticated() &&
        request.auth.uid == userId &&
        !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['role', 'tier', 'maxCities', 'status', 'citiesUsed', 'citiesApproved', 'orgAssignments', 'orgId']);

      // 관리자 이메일 계정: DB role이 꼬였을 때 자기복구 허용 (#4)
      allow update: if isAdminEmail() && request.auth.uid == userId;

      // 관리자: 전체 쓰기
      allow write: if isAdmin();
    }

    // ── 알림: 관리자만 ───────────────────────────────────────────────────────
    match /notifications/{notificationId} {
      allow read, write: if isAdmin();
    }

    function hasCityAccess(cityId) {
      let uData = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return 'citiesApproved' in uData &&
        uData.citiesApproved is list &&
        uData.citiesApproved.hasAll([cityId]);
    }

    // ── 기본명단: 데이터는 기업에 귀속 — 본인 승인 지자체 담당자 풀 CRUD (등록·수정·삭제) ──
    match /base_lists/{cityId} {
      allow read, write: if isAuthenticated() && (hasCityAccess(cityId) || isAdmin() || isAdminEmail());

      match /records/{recordId} {
        allow read, write: if isAuthenticated() && (hasCityAccess(cityId) || isAdmin() || isAdminEmail());
      }
    }

    // ── 월별 배송명단: 읽기는 승인 사용자, 쓰기는 관리자, 기사·배송순번은 담당자도 수정 가능 ──
    match /cloud_lists/{cityId} {
      // 데이터는 기업에 귀속 — 본인 승인 지자체 담당자 풀 CRUD (등록·수정·삭제)
      // isAdminEmail(): JWT 직접 확인 — isAdmin()의 Firestore get() 실패 시 폴백
      allow read, write: if isAuthenticated() && (hasCityAccess(cityId) || isAdmin() || isAdminEmail());

      match /months/{monthId} {
        allow read, write: if isAuthenticated() && (hasCityAccess(cityId) || isAdmin() || isAdminEmail());

        match /records/{recordId} {
          allow read, write: if isAuthenticated() && (hasCityAccess(cityId) || isAdmin() || isAdminEmail());
        }
      }
    }

    // ── 지자체 신청: 본인 생성(pending만), 본인·관리자 조회, 관리자 수정 ──────
    match /city_requests/{requestId} {
      allow create: if isAuthenticated() &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.status == 'pending';
      allow read: if isAuthenticated() &&
        (resource.data.uid == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }

    // ── 조직 배분 프리셋: 읽기는 승인 사용자, 쓰기는 관리자 ─────────────────────
    match /org_presets/{cityId} {
      allow read: if isAuthenticated() && (hasCityAccess(cityId) || isAdmin());
      allow write: if isAdmin();
    }

    // ── 공유링크 비밀번호 토큰 (2026-08-23 · 형 지시 "지도 생성할 때 비밀번호 숫자 6자리") ──
    //  openShare Function 이 비밀번호를 검증한 뒤 발급하는 커스텀 토큰(claims.shareId). 그 공유 하나에만 통한다.
    //  ★링크만 아는 것으로는 더 이상 못 연다 — 화면 비교는 장식이고 **여기서 막아야** 개발자도구로도 못 본다.
    function hasShareToken(shareId) {
      return request.auth != null && request.auth.token.get('shareId', '') == shareId;
    }
    // 토큰에 박힌 기사 ID — 건별 문서는 **이 기사 것만** 읽힌다(토큰 하나로 그 공유 전 건이 열리면 안 된다 · 검사 지적)
    function tokenDriverId() {
      return request.auth.token.get('driverId', '');
    }
    // 건별 문서(records)는 만료 필드가 없다 — **부모 공유 문서**의 만료를 본다.
    //  (예전 규칙은 레코드 자신의 expiresAt 을 봐서 기사 읽기가 원래부터 막혀 있었고, 옛 배열 폴백이 그걸 가리고 있었다)
    function parentShareAlive(shareId) {
      return exists(/databases/$(database)/documents/route_shares/$(shareId)) &&
        'expiresAt' in get(/databases/$(database)/documents/route_shares/$(shareId)).data &&
        get(/databases/$(database)/documents/route_shares/$(shareId)).data.expiresAt > request.time;
    }
    // 건별 문서의 소유자 = 부모 공유의 생성자(이메일 또는 uid — SSO 담당자는 email 클레임이 없을 수 있다)
    // ★빈 문자열 동치 차단 — SSO 담당자(email 클레임 없음)가 만든 공유는 createdBy:'' 로 저장되는데,
    //   '' == token.get('email','') 이 참이 되어 email 없는 담당자 전원이 서로의 공유를 읽고 지울 수 있었다(2차 검사 실측).
    function ownerEmailMatch(createdBy) {
      return createdBy != '' && createdBy == request.auth.token.get('email', '');
    }
    function isParentShareOwner(shareId) {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/route_shares/$(shareId)) &&
        (ownerEmailMatch(get(/databases/$(database)/documents/route_shares/$(shareId)).data.get('createdBy', '')) ||
         get(/databases/$(database)/documents/route_shares/$(shareId)).data.get('createdByUid', '-') == request.auth.uid);
    }

    // ── 배송 루트 공유: 생성은 인증 사용자, 읽기는 누구나 (기사 접근) ──────────
    function isRouteOwner() {
      return isAuthenticated() &&
        (ownerEmailMatch(resource.data.get('createdBy', '')) ||
         resource.data.get('createdByUid', '-') == request.auth.uid);
    }

    function isShareWithinTTL() {
      return ('expiresAt' in resource.data && resource.data.expiresAt > request.time) ||
        (!('expiresAt' in resource.data) && 'createdAt' in resource.data &&
         resource.data.createdAt + duration.value(45, 'd') > request.time);
    }

    // ⛔`drivers` 는 **이 프로젝트의 기사 명부가 아니다**(2026-08-13 실측: 0건).
    //   진짜 명부 = **`org_drivers/{소속사}/drivers`**(화면 "소속사 기사 관리",
    //   `DriverRegistryModal.jsx`). 아래 `match /org_drivers/...` 규칙이 그걸 지킨다.
    //   ★안토니가 컬렉션 이름만 보고 "명부가 없다"고 두 번 잘못 판단했다 —
    //     **부재 단정을 이름 하나로 하지 말 것.** 같은 것이 다른 이름으로 있다.
    //   아래 규칙은 혹시 이 컬렉션을 쓰게 될 때를 대비한 최소 잠금이다(현재 미사용).
    //
    //  ★번호는 E.164(`+8210…`) 비교키(`phoneE164`)를 따로 둔다(`src/utils/phone.js`).
    //    Phone Auth 토큰의 `phone_number` 와 **문자 그대로** 비교하므로, 표기가 흔들리면
    //    에러도 없이 그 기사만 조용히 막힌다.
    match /drivers/{driverId} {
      // 담당자·관리자: 명부 관리(목록 포함).
      //  ⚠️명부는 지자체별로 나뉘지 않는다(기사는 여러 지자체를 돈다) → 인증 사용자면 읽고,
      //    쓰기는 관리자만. 명부를 아무나 고치면 남의 번호를 넣어 지도를 열 수 있다.
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (isAdmin() || isAdminEmail());
      // 기사 본인: 휴대폰 인증으로 들어와 자기 등록 상태만 확인
      allow get: if isAuthenticated()
                 && request.auth.token.phone_number != null
                 && resource.data.phone == request.auth.token.phone_number;
    }

    // ── 공유 열람 기록 (Phase 5 · 2026-08-13) ───────────────────────────────
    //  ★개정 개인정보보호법(2026-09-11)의 **72시간 유출 통지는 '인지'가 전제**다.
    //    누가 언제 어느 공유를 몇 건 열었는지 안 남기면 유출을 알아챌 수단이 없고,
    //    알아채도 "언제 인지했는지"를 증명할 수 없다.
    //  ★append-only — 수정·삭제 금지(yyplus `auditLogs` 방식).
    //    지울 수 있는 기록은 사고 때 제일 먼저 지워진다.
    match /share_access_logs/{logId} {
      //  기록은 **막지 않는다** — 남기는 것이 목적이다. 다만 형태는 검사해 잡동사니를 거른다.
      //  (⚠️`isShareWithinTTL()` 은 `resource.data` 를 보는데 여기엔 그 문서가 없다 → 못 쓴다)
      allow create: if request.resource.data.keys().hasAll(['at', 'shareId', 'count'])
                    && request.resource.data.count is number
                    && request.resource.data.shareId is string;
      //  읽기는 관리자만 — 누가 무엇을 봤는지가 담긴다(이것도 개인정보다).
      allow read: if isAdmin() || isAdminEmail();
      allow update, delete: if false;
    }

    // ── 공유링크 비밀번호 해시 (2026-08-23) — 기사·익명은 절대 못 읽는다. 검증은 openShare Function(admin SDK)이 한다 ──
    //  ★공유 문서에 해시를 넣으면 토큰을 가진 기사가 읽어 6자리를 즉시 역산한다 → 별도 문서 + 읽기 금지.
    match /route_share_secrets/{shareId} {
      // 생성은 **부모 공유의 소유자**만 — 남의 옛 공유에 비밀번호를 걸어 기사를 잠그는 것 차단(검사 지적).
      //  부모가 이미 있으면 그 문서로, 같은 배치에서 함께 만드는 중이면 getAfter 로 소유자를 본다.
      allow create: if isAuthenticated()
                    && request.resource.data.createdByUid == request.auth.uid
                    && (
                      (exists(/databases/$(database)/documents/route_shares/$(shareId)) &&
                       get(/databases/$(database)/documents/route_shares/$(shareId)).data.get('createdByUid', '-') == request.auth.uid) ||
                      (!exists(/databases/$(database)/documents/route_shares/$(shareId)) &&
                       getAfter(/databases/$(database)/documents/route_shares/$(shareId)).data.get('createdByUid', '-') == request.auth.uid)
                    )
                    && request.resource.data.keys().hasAll(['passcodeHash', 'passcodeSalt', 'createdByUid'])
                    && request.resource.data.passcodeHash is string
                    && request.resource.data.passcodeSalt is string;
      // 비밀번호 재설정: 생성자·관리자만, 해시·솔트만 바꿀 수 있다
      allow update: if isAuthenticated()
                    && (resource.data.get('createdByUid', '-') == request.auth.uid || isAdmin() || isAdminEmail())
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['passcodeHash', 'passcodeSalt', 'updatedAt']);
      allow read, delete: if isAdmin() || isAdminEmail();
    }

    match /route_shares/{shareId} {
      // 관리자(목록 조회 포함) · 토큰 가진 기사(유효기간 내) · 생성자 · (보류 중인 휴대폰 인증 경로). ★무인증 읽기는 닫혔다(2026-08-23).
      allow read: if isAdmin() || isAdminEmail() ||
        (isShareWithinTTL() && (hasShareToken(shareId) || isRouteOwner() ||
          (isAuthenticated() && request.auth.token.get('phone_number', '-') in resource.data.get('driverPhones', []))));

      allow create: if isAuthenticated();

      // 생성자·관리자: 전체 수정 허용
      // 기사(미인증 포함): 유효 공유 링크 범위 내에서 liveGps·driverOrder·orderApplyRequests·completions만 수정
      allow update: if isRouteOwner() || isAdmin() ||
        (
          isShareWithinTTL() &&
          hasShareToken(shareId) &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['liveGps', 'driverOrder', 'orderApplyRequests', 'completions']) &&
          (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['liveGps'])
            || request.resource.data.liveGps is map) &&
          (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['driverOrder'])
            || request.resource.data.driverOrder is map) &&
          (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['orderApplyRequests'])
            || request.resource.data.orderApplyRequests is map) &&
          // completions: 완료 기록(map) 또는 마지막 건 취소로 필드 소멸(deleteField)까지 허용, 타입 변조만 차단
          (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['completions'])
            || !('completions' in request.resource.data)
            || request.resource.data.completions is map)
        );

      // 삭제는 생성자·관리자만
      allow delete: if isRouteOwner() || isAdmin();

      // ── 건별 배송 문서 (Phase 1 · 2026-08-13) ──────────────────────────
      //  ★배열이던 records 를 여기로 쪼갰다. **배열은 부분 권한을 줄 수 없다** —
      //    읽히면 1,524건이 통째로 나간다. 건별 문서라야 "자기 것만"이 성립한다(형 확정 B).
      //  ★화면에서 거르는 방식은 우회된다(개발자도구로 원본을 그대로 본다).
      //    여기서 막아야 **DB 차원에서** 남의 배송을 못 읽는다.
      match /records/{recId} {
        // 기사: 공유 비밀번호 토큰(2026-08-23, 그 공유의 전 건) 또는 휴대폰 인증(자기 배송건만). 생성자·관리자는 전체.
        //  ★만료는 부모 공유 문서 기준(parentShareAlive) — 레코드엔 만료 필드가 없다.
        //  ★토큰 경로는 **토큰에 박힌 기사(driverId)의 건만** — 토큰 하나로 그 공유 전 건이 열리면 기사 화면에 남의 명단이 뜬다(검사 지적).
        //    (비밀번호는 지도 단위라 driverId 는 URL 값이지만, 최소한 같은 링크의 기사끼리는 서로의 건을 못 본다)
        allow read: if isParentShareOwner(shareId) || isAdmin() || isAdminEmail() ||
          (
            parentShareAlive(shareId) &&
            (
              (hasShareToken(shareId) && resource.data.driverId == tokenDriverId()) ||
              (
                isAuthenticated() &&
                resource.data.driverPhone == request.auth.token.get('phone_number', '-')
              )
            )
          );

        // 쓰기(명단 배치)는 생성자·관리자만.
        allow create, delete: if isParentShareOwner(shareId) || isAdmin() || isAdminEmail();

        // 기사는 **현장 기록만** 고친다(수령확인·순번 적용). 주소·이름·소유기사는 못 건드린다.
        //  ⚠️driverPhone 을 고칠 수 있으면 자기 번호로 바꿔 남의 건을 가져갈 수 있다 → 반드시 제외.
        allow update: if isParentShareOwner(shareId) || isAdmin() || isAdminEmail() ||
          (
            parentShareAlive(shareId) &&
            (
              (hasShareToken(shareId) && resource.data.driverId == tokenDriverId()) ||
              (
                isAuthenticated() &&
                resource.data.driverPhone == request.auth.token.get('phone_number', '-')
              )
            ) &&
            request.resource.data.driverId == resource.data.driverId &&
            request.resource.data.driverPhone == resource.data.driverPhone &&
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['received', 'receivedAt', 'completion', 'held', 'heldReason', '배송순번'])
          );
      }
    }

    // ── 배송 세션: 기사구성·구역배정 영구저장 (승인 사용자) ─────────────────────
    match /route_sessions/{cityId} {
      allow read: if isAuthenticated() && (hasCityAccess(cityId) || isAdmin());
      allow write: if isAuthenticated() && (hasCityAccess(cityId) || isAdmin());

      match /months/{monthId} {
        allow read: if isAuthenticated() && (hasCityAccess(cityId) || isAdmin());
        allow write: if isAuthenticated() && (hasCityAccess(cityId) || isAdmin());
      }
    }

    // ── 좌표 캐시: 한번 받은 좌표 영구 재사용 (승인 사용자) ─────────────────────
    match /coordinate_cache/{cityId} {
      allow read: if isAuthenticated() && (hasCityAccess(cityId) || isAdmin());
      allow write: if isAuthenticated() && (hasCityAccess(cityId) || isAdmin());

      match /addresses/{addrId} {
        allow read: if isAuthenticated() && (hasCityAccess(cityId) || isAdmin());
        allow write: if isAuthenticated() && (hasCityAccess(cityId) || isAdmin());
      }
    }

    // ── cloud_lists 담당자 필드 확장 (좌표·isApt 업데이트 허용) ─────────────────
    // (기존 규칙 override — cloud_lists 블록 내 allow update 조건 확장은 아래로 처리)

    // ── 소속사 기사 마스터: 본인 소속사만 읽기·쓰기, 관리자 전체 제어 ──────────
    match /org_drivers/{orgName} {
      allow read: if isAuthenticated() &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.orgId == orgName || isAdmin());
      allow write: if isAuthenticated() &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.orgId == orgName || isAdmin());

      match /drivers/{driverId} {
        allow read: if isAuthenticated() &&
          (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.orgId == orgName || isAdmin());
        allow write: if isAuthenticated() &&
          (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.orgId == orgName || isAdmin());
      }
    }

    // ── 사용자 개인 기사: 본인만 읽기·쓰기, 관리자 전체 제어 ─────────────────
    match /user_drivers/{uid} {
      allow read: if isAuthenticated() && (request.auth.uid == uid || isAdmin());
      allow write: if isAuthenticated() && (request.auth.uid == uid || isAdmin());

      match /drivers/{driverId} {
        allow read: if isAuthenticated() && (request.auth.uid == uid || isAdmin());
        allow write: if isAuthenticated() && (request.auth.uid == uid || isAdmin());
      }
    }

    // ── 기사 배정 프리셋: 읽기·쓰기는 승인 사용자 (루트맵 셋업 저장용) ───────────
    match /driver_assignments/{cityId} {
      allow read: if isAuthenticated() && (hasCityAccess(cityId) || isAdmin() || isAdminEmail());
      allow write: if isAuthenticated() && (hasCityAccess(cityId) || isAdmin() || isAdminEmail());

      match /orgs/{orgKey} {
        allow read: if isAuthenticated() && (hasCityAccess(cityId) || isAdmin() || isAdminEmail());
        allow write: if isAuthenticated() && (hasCityAccess(cityId) || isAdmin() || isAdminEmail());
      }
    }

    // ── 배송 실적 이력: 읽기·쓰기는 승인 사용자 ──────────────────────────────
    match /delivery_history/{cityId} {
      allow read: if isAuthenticated() && (hasCityAccess(cityId) || isAdmin());
      allow write: if isAuthenticated() && (hasCityAccess(cityId) || isAdmin());

      match /months/{monthId} {
        allow read: if isAuthenticated() && (hasCityAccess(cityId) || isAdmin());
        allow write: if isAuthenticated() && (hasCityAccess(cityId) || isAdmin());

        match /records/{recordId} {
          allow read: if isAuthenticated() && (hasCityAccess(cityId) || isAdmin());
          allow write: if isAuthenticated() && (hasCityAccess(cityId) || isAdmin());
        }

        match /drivers/{driverId} {
          allow read: if isAuthenticated() && (hasCityAccess(cityId) || isAdmin());
          allow write: if isAuthenticated() && (hasCityAccess(cityId) || isAdmin());
        }
      }
    }

    // ── 배송일정: 본인 데이터만 읽기·쓰기 ─────────────────────────────────────
    match /schedule_records/{userId}/{document=**} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }

    // ── 배송일정 기사 목록: 본인·관리자 읽기·쓰기 ─────────────────────────────
    match /schedule_drivers/{uid} {
      allow read, write: if isAuthenticated() && (request.auth.uid == uid || isAdmin());
    }

    // ── 개인 기사매칭 프리셋: 본인만 읽기·쓰기 ────────────────────────────────
    match /user_driver_presets/{uid} {
      allow read, write: if isAuthenticated() && (request.auth.uid == uid || isAdmin());
      match /cities/{cityId} {
        allow read, write: if isAuthenticated() && (request.auth.uid == uid || isAdmin());
      }
    }

    // ── 사용자 회사(companyCode 기반): 본인 생성·수정, 관리자 전체 ───────────────
    match /user_companies/{companyCode} {
      allow read: if isAuthenticated();
      // 관리자는 기업을 직접 생성(ownerUid 없이). 일반 사용자는 자기 소유 기업만.
      allow create: if isAuthenticated() &&
        (request.resource.data.ownerUid == request.auth.uid || isAdmin() || isAdminEmail());
      allow update: if isAuthenticated() &&
        (resource.data.ownerUid == request.auth.uid || isAdmin() || isAdminEmail());
      allow delete: if isAdmin() || isAdminEmail();

      // 기업소속 기사: 관리자 / 기업 소유자 / 해당 기업 담당자(companyCode 일치) 접근
      match /drivers/{driverId} {
        allow read, write: if isAuthenticated() && (
          isAdmin() || isAdminEmail() ||
          get(/databases/$(database)/documents/user_companies/$(companyCode)).data.ownerUid == request.auth.uid ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyCode == companyCode
        );
      }
    }

    // ── 기본 차단 (Zero Trust) ───────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
